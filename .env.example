# Public URL the site is served from — used for canonical URLs, sitemap and OG tags.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where enquiry-form leads are POSTed as JSON (Google Apps Script web app,
# Zapier/Make/Pabbly webhook, CRM endpoint, ...). Leave empty to rely on the
# WhatsApp hand-off shown after submit.
LEAD_WEBHOOK_URL=
